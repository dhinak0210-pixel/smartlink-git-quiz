# =========================================================================
# SmartLink Git Quiz — Layer 3: AI Configuration (.env)
# =========================================================================

# Primary AI Provider: Google Gemini (Free Tier)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Backup AI Provider: Groq (Free Tier)
# Get a key at: https://console.groq.com/keys
GROQ_API_KEY=

# Supabase Credentials (matching live app Layer 1)
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

# Provider Selection: "gemini" or "groq"
AI_PROVIDER=gemini

# Event Metadata
EVENT_NAME=SmartLink Git Quiz 2026
EVENT_DATE=2026-10-22
ORGANIZER_NAME=SmartLink Tech Team
